{
  "name": "@local/smueval-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "南方医科大学教学服务平台「随堂评价」每日定时自动完成插件（DeepSeek Harness）",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "playwright",
    "automation"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "browser.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
